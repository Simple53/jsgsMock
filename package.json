{
  "name": "jsgs-mock",
  "version": "1.4.6",
  "description": "jsgsMock - 高校教资智能刷题与名师视频系统",
  "main": "electron-main.js",
  "author": "Simple53",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win nsis --x64",
    "pack:mac": "electron-builder --mac dmg --universal",
    "pack:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jsgsmock.app",
    "productName": "jsgsMock",
    "copyright": "Copyright © 2026 Simple53",
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "zh", "en-US", "en"],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "web/**/*",
      "!web/**/*.md",
      "!web/**/*.docx",
      "!web/**/*.json",
      "web/version.json",
      "web/manifest.json",
      "!web/videos/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "web/icon.png",
      "artifactName": "${productName}-v${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "jsgsMock",
      "differentialPackage": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "web/icon.png",
      "identity": null,
      "artifactName": "${productName}-v${version}-macos-${arch}.${ext}",
      "category": "public.app-category.education"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "web/icon.png",
      "artifactName": "${productName}-v${version}-linux-${arch}.${ext}",
      "category": "Education"
    }
  }
}
